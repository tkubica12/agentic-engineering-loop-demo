{
  "$comment": "Profile selection for the showcase. Override with SHOWCASE_PROFILE=<id>. This file is public and carries no customer-specific identifier. Neutrality is enforced structurally, by the rules below, rather than by listing real names.",
  "defaultProfile": "sandbox",
  "profileDir": "config/profiles",
  "demoMarker": "aeloop-showcase",
  "productValidationDate": "2026-08-24",
  "repository": {
    "$comment": "This public repository's own coordinates. The standalone export needs them to rewrite sibling links to absolute URLs.",
    "owner": "tkubica12",
    "name": "agentic-engineering-loop-demo",
    "ref": "main"
  },
  "neutrality": {
    "$comment": "Two structural rules keep this public repository customer-neutral. First, no profile may carry a concrete organisation, tenant, subscription or directory value: those fields are null or a documented placeholder, and the target is supplied on the command line. Second, attendee-facing documents may use only the proper nouns allowed below, so an unrecognised name fails the build instead of being published quietly. A presenter who needs to check for engagement-specific terms puts them in an untracked .showcase.local.json; see .showcase.local.example.json. That file is never committed.",
    "identityFields": [
      "owner",
      "repo",
      "organisation",
      "organization",
      "org",
      "tenantId",
      "subscriptionId",
      "directoryId",
      "customer",
      "account"
    ],
